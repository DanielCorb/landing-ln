# Public base URL of the deployed site (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://lumeanoua.com

# Firebase Client SDK (public — exposed to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (server-side only — NOT exposed to the browser)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Contact form — fallback recipient.
# The real source is the dashboard: Setări > "Email notificări", stored as
# settings/general.notificationEmail. This is used only while that field is empty.
# Delivery uses the same SMTP mailbox as the newsletter (see below); the sender is
# NEWSLETTER_FROM_EMAIL and the visitor's address goes into Reply-To.
CONTACT_RECEIVER_EMAIL=contact@lumeanoua.com

# Shared secret for POST /api/revalidate. Must match REVALIDATE_SECRET in the dashboard.
REVALIDATE_SECRET=change_me

# ---------------------------------------------------------------------------
# Newsletter — SMTP (the cPanel mailbox that ships with the domain)
# ---------------------------------------------------------------------------
# Values come from cPanel > Email Accounts > Connect Devices.
#
# SMTP_HOST is the *server* hostname, not mail.<domain>. Shared hosting installs
# a wildcard certificate for the provider's own domain, which covers the server
# hostname but not yours; nodemailer validates the certificate, so mail.<domain>
# fails on a name mismatch unless AutoSSL has issued one — and not every plan
# exposes AutoSSL. mail.<domain> is still needed in DNS as the MX target: that is
# the path mail comes *in* on. Only sending uses the server hostname.
#
# Leave SMTP_HOST empty to disable sending: every email becomes a logged no-op
# and nothing else on the site changes.
SMTP_HOST=serverNNN.web-hosting.com
SMTP_PORT=465
# 465 = implicit TLS (secure=true). 587 = STARTTLS (secure=false).
SMTP_SECURE=true
# The full email address, not just the part before the @.
SMTP_USER=newsletter@your-domain.com
SMTP_PASSWORD=change_me

# Sender readers see. Must be a real mailbox on the SMTP domain, otherwise the
# server refuses to relay it. The domain also needs SPF, DKIM and DMARC records
# or the mail lands in spam.
NEWSLETTER_FROM_EMAIL="Lumea Nouă <newsletter@lumeanoua.com>"

# Fallback inbox for subscribe / unsubscribe / contact notices. The real source is
# the dashboard: Setări > "Email notificări". Unset and unconfigured = no notices.
NEWSLETTER_ADMIN_EMAIL=contact@lumeanoua.com

# Signs unsubscribe links and authenticates POST /api/newsletter/notify.
# Must match NEWSLETTER_SECRET in dashboard-LN/src/functions/.env.
# Rotating it invalidates every unsubscribe link already delivered.
NEWSLETTER_SECRET=change_me

# --- Send pacing -------------------------------------------------------------
# The mailbox accepts a fixed number of messages per hour PER DOMAIN, and that
# budget is shared with welcome emails and contact notifications. Going over does
# not queue, it fails — so an issue is delivered in batches, one per interval,
# until the list runs out. The interval is enforced by the endpoint itself, not
# by how often the scheduler happens to fire.
#
# 40 / 60 suits a 50-per-hour plan. Raise both together on a bigger plan.
NEWSLETTER_BATCH_SIZE=40
NEWSLETTER_BATCH_INTERVAL_MINUTES=60

# Messages in flight at once inside a single batch.
NEWSLETTER_SEND_CONCURRENCY=4

# ---------------------------------------------------------------------------
# First-party tracking (optional — leave empty to disable)
# ---------------------------------------------------------------------------
# 1) In the dashboard: Tracking → generate ingest key + download tracker.js
# 2) Copy tracker.js into landing-ln/public/tracker.js
# 3) Fill these (DATA_KEY must match the passphrase used in the dashboard analytics page)
NEXT_PUBLIC_LN_INGEST_KEY=
NEXT_PUBLIC_LN_API_BASE=http://localhost:3001
NEXT_PUBLIC_LN_DATA_KEY=
# Used by the embed element picker when opened as ?ln_embed_picker=1
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
